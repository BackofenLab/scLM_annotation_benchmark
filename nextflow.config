params.datasets = ['Zeisel', 'HFRA', 'tabula_sapiens_ear_CxG', 'human_pancreas']
params.models = ['celltypist', 'langcell-zeroshot', 'c2s', 'scsa']
params.throttled_models = ['openrouter_LLM']
params.cache_dir = 'cache'
params.apply_ontology_mapping = true
