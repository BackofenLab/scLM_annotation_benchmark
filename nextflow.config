process {
    // Prefer libraries from the active conda env (e.g. libstdc++) over system libs.
    // KMP_DUPLICATE_LIB_OK works around a macOS conda-env quirk where matplotlib + seaborn
    // each load their own libomp and abort with OMP Error #15. Safe for our numerical work.
    beforeScript = '''
        if [[ -n "${CONDA_PREFIX:-}" ]]; then
            export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
        fi
        export KMP_DUPLICATE_LIB_OK=TRUE
    '''
}

// Define use_docker parameter before profiles so it can be used
params.use_docker = false  // Set to true to use Docker instead of conda
params.container_image = 'pavanvidem/sc_lfm:2026-04-17'

// Docker/Apptainer shared configuration
docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp -e MPLCONFIGDIR=/tmp'
docker.temp = 'auto'
apptainer.runOptions = '-e HOME=/tmp -e MPLCONFIGDIR=/tmp'

profiles {
    
    local {
        process.executor   = 'local'   // run on this machine
        process.cpus       = 4
        process.memory     = '32 GB'
        conda.enabled      = true      // honour conda directives
        docker.enabled     = false

    }

    helix {
        conda.enabled = !params.use_docker
        docker.enabled = params.use_docker
        process.container = params.use_docker ? params.container_image : null
        process {
            withName: 'run_model|run_model_openrouter' {
                queue = 'gpu-single'
                time = '4h'
                clusterOptions = '--gres=gpu:1'
                executor = 'slurm'
                memory = '64 GB'
            }
            queue = 'cpu-single'
            time = '1h'
            executor = 'slurm'
            memory = '128 GB'
            cpus = 1

        }
    }
    imbi_gpu {
    conda.enabled = true

    process {
      executor = 'local'
      time     = '1h'
      memory   = '60 GB'
      cpus     = 1

      withName: 'run_model|run_model_openrouter' {
        executor       = 'slurm'
        time           = '48h'
        memory         = '60 GB'
        clusterOptions = '--gres=gpu:1'
      }

    }
  }

    docker {
        docker.enabled = true
        conda.enabled = false
        process.container = params.container_image
        process.executor = 'local'
        process.cpus = 12
        process.memory = '48 GB'

        process {
            withName: 'run_model|run_model_openrouter' {
                containerOptions = '--gpus 1'
            }
        }
    }

    // Laptop-sized Docker profile: no GPU, matches the `local` profile's resources.
    // Apple Silicon users rely on Docker Desktop's amd64 emulation (slower).
    docker_local {
        docker.enabled = true
        conda.enabled = false
        process.container = params.container_image
        process.executor = 'local'
        process.cpus = 4
        process.memory = '80 GB'
    }

    apptainer {
        apptainer.enabled = true
        conda.enabled = false
        process.container = "docker://${params.container_image}"
        process.executor = 'local'
        process.cpus = 12
        process.memory = '48 GB'

        process {
            withName: 'run_model|run_model_openrouter' {
                containerOptions = '--nv'
            }
        }
    }
}

workDir = "work"
params.datasets = ['Zeisel', 'HFRA', 'human_pancreas', 'HIHA']
params.models = ['cell_baseline', 'openrouter_LLM_blind', 'openrouter_LLM_unblind', 'celltypist_blind', 'c2s_blind', 'c2s_scale_2B_blind', 'c2s_scale_2B_unblind', 'c2s_scale_27B_blind', 'c2s_scale_27B_unblind', 'cellwhisperer_blind', 'cellwhisperer_unblind', 'instructcell_blind', 'instructcell_unblind', 'langcell_blind', 'langcell_unblind', 'mmcontext_blind', 'mmcontext_unblind', 'random_stratified', 'random_uniform', 'scsa_blind']
params.cache_dir = 'cache'
params.apply_ontology_mapping = true  // fallback for datasets without per-dataset flag
params.use_text_encoder = true  // also compute mapping-free text-encoder cosine similarity in evaluation
params.text_encoder_model = 'cambridgeltl/SapBERT-from-PubMedBERT-fulltext'  // HF encoder for the text-similarity metric (use 'sentence-transformers/all-MiniLM-L6-v2' for a zero-download fallback)
params.min_scoring_coverage = 0.9  // min fraction of cells with a trusted mapping (direct CL term OR reviewed=True) needed to emit metrics; below this a model's metrics are NaN
params.download_from_zenodo = true  // if true, fetch preprocessed+subsetted files from Zenodo instead of running download→preprocess→subset
params.min_cells_per_type = 20       // minimum cells per cell type in subset (types below are dropped)
params.subset_categories = [
    'openrouter': 1000,            // LLMs get the smaller subset
    'langcell_blind': 1000,        // Very slow
    'default': [1000, 10000]       // all other models run at BOTH sizes (a value may be a single
                                   // size or a list of sizes; the model is run once per size)
]
params.subset_strategy = 'stratified'  // 'stratified' (preserve proportions) or 'random' (uniform, preserve natural imbalance)
// OpenRouter API key is provided via Nextflow secrets (see README): nextflow secrets set OPENROUTER_API_KEY 'sk-or-v1-...'
// Only the run_model_openrouter process declares `secret 'OPENROUTER_API_KEY'`, which injects the value into the
// task env at runtime without writing it into the work directory's .command.sh / .command.run files. Non-OpenRouter
// models run via run_model, which does not declare the secret, so they don't require the key to be set.

// Models that should be skipped for specific organisms (keys are normalized to lowercase).
// Example: 'mus musculus' => ['mmcontext_blind', 'mmcontext_unblind']
params.model_blacklist_by_organism = [
    'mus musculus': ['mmcontext_blind', 'mmcontext_unblind'],
]
