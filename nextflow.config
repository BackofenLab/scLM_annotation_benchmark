process {
    // Prefer libraries from the active conda env (e.g. libstdc++) over system libs.
    beforeScript = '''
        if [[ -n "${CONDA_PREFIX:-}" ]]; then
            export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
        fi
    '''
}

// Define use_docker parameter before profiles so it can be used
params.use_docker = true  // Set to true to use Docker instead of conda
params.container_image = 'pavanvidem/sc_lfm:2026-04-17'

// Docker/Apptainer shared configuration
docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp -e MPLCONFIGDIR=/tmp'
docker.temp = 'auto'
apptainer.runOptions = '-e HOME=/tmp -e MPLCONFIGDIR=/tmp'

profiles {
    
    local {
        process.executor   = 'local'   // run on this machine
        process.cpus       = 12
        process.memory     = '48 GB'
        conda.enabled      = true
        docker.enabled     = false

        process {
            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }

    helix {
        conda.enabled = !params.use_docker
        docker.enabled = params.use_docker
        process.container = params.use_docker ? params.container_image : null
        process {
            withName: run_model {
                queue = 'gpu-single'
                time = '4h'
                clusterOptions = '--gres=gpu:1'
                executor = 'slurm'
                memory = '64 GB'
            }
            queue = 'cpu-single'
            time = '1h'
            executor = 'slurm'
            memory = '128 GB'
            cpus = 1

            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }
    imbi_gpu {
    conda.enabled = true

    process {
      executor = 'slurm'
      queue    = 'gpu'
      time     = '1h'
      memory   = '60 GB'
      cpus     = 1

      withName: run_model {
        time           = '4h'
        memory         = '60 GB'
        clusterOptions = '--gres=gpu:1'
      }

      withName: run_model_throttled {
        maxForks = 1
      }
    }
  }

    docker {
        docker.enabled = true
        conda.enabled = false
        process.container = params.container_image
        process.executor = 'local'
        process.cpus = 12
        process.memory = '48 GB'

        process {
            withName: 'run_model|run_model_throttled' {
                containerOptions = '--gpus 1'
            }
            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }

    apptainer {
        apptainer.enabled = true
        conda.enabled = false
        process.container = "docker://${params.container_image}"
        process.executor = 'local'
        process.cpus = 12
        process.memory = '48 GB'

        process {
            withName: 'run_model|run_model_throttled' {
                containerOptions = '--nv'
            }
            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }
}

//workDir = "/scratch/local/menger/sc_language/work"
workDir = "work"
params.datasets = ['Zeisel', 'HIHA', 'human_pancreas']
params.models = ['celltypist_blind']
//, 'cellwhisperer_blind', 'c2s_blind', 'scsa_blind']
params.throttled_models = ['openrouter_LLM']
//params.cache_dir = '/scratch/local/menger/sc_language/cache'
params.cache_dir = "cache"
params.apply_ontology_mapping = true
