process {
    // Prefer libraries from the active conda env (e.g. libstdc++) over system libs.
    beforeScript = '''
        if [[ -n "${CONDA_PREFIX:-}" ]]; then
            export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
        fi
    '''
}

profiles {
    
    local {
        process.executor   = 'local'   // run on this machine
        process.cpus       = 4
        process.memory     = '8 GB'
        conda.enabled      = true      // honour conda directives

        process {
            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }

    helix {
        conda.enabled = true
        process {
            withName: run_model {
                queue = 'gpu-single'
                time = '4h'
                clusterOptions = '--gres=gpu:1'
                executor = 'slurm'
                memory = '64 GB'
            }
            queue = 'cpu-single'
            time = '1h'
            executor = 'slurm'
            memory = '128 GB'
            cpus = 1

            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }
    imbi_gpu {
    conda.enabled = true

    process {
      executor = 'slurm'
      queue    = 'gpu'
      time     = '1h'
      memory   = '60 GB'
      cpus     = 1

      withName: run_model {
        time           = '4h'
        memory         = '60 GB'
        clusterOptions = '--gres=gpu:1'
      }

      withName: run_model_throttled {
        maxForks = 1
      }
    }
  }
}

//workDir = "/scratch/local/menger/sc_language/work"
workDir = "work"
params.datasets = ['Zeisel', 'HIHA', 'human_pancreas']
params.models = ['celltypist_blind']
//, 'cellwhisperer_blind', 'c2s_blind', 'scsa_blind']
params.throttled_models = ['openrouter_LLM']
//params.cache_dir = '/scratch/local/menger/sc_language/cache'
params.cache_dir = "cache"
params.apply_ontology_mapping = true
