process {
    // Prefer libraries from the active conda env (e.g. libstdc++) over system libs.
    // KMP_DUPLICATE_LIB_OK works around a macOS conda-env quirk where matplotlib + seaborn
    // each load their own libomp and abort with OMP Error #15. Safe for our numerical work.
    beforeScript = '''
        if [[ -n "${CONDA_PREFIX:-}" ]]; then
            export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
        fi
        export KMP_DUPLICATE_LIB_OK=TRUE
    '''
}

// Define use_docker parameter before profiles so it can be used
params.use_docker = false  // Set to true to use Docker instead of conda
params.container_image = 'pavanvidem/sc_lfm:2026-04-17'

// The R-based annotators (SingleR tiers + scType) need R/Bioconductor, which is NOT in the
// Python-only sc_lfm image. Under the container profiles (docker/apptainer/helix) these models
// run in a dedicated R image instead (built from envs/Dockerfile.r); every other process keeps
// params.container_image. Selection is per-model (see containerFor() in main.nf), so the existing
// container mapping for all other methods is untouched. Ignored under the conda `local` profile.
params.r_container_image = 'pavanvidem/sc_lfm_r:2026-04-17'   // build+push from envs/Dockerfile.r
params.r_container_models = ['sctype_blind', 'sctype_unblind', 'singler_blind', 'singler_unblind', 'singler_main_blind', 'singler_fine_blind', 'singler_ont_blind']

// Docker/Apptainer shared configuration
docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp -e MPLCONFIGDIR=/tmp'
docker.temp = 'auto'
apptainer.runOptions = '-e HOME=/tmp -e MPLCONFIGDIR=/tmp'

profiles {
    
    local {
        process.executor   = 'local'   // run on this machine
        process.cpus       = 4
        process.memory     = '32 GB'
        conda.enabled      = true      // honour conda directives
        docker.enabled     = false

    }

    helix {
        conda.enabled = !params.use_docker
        docker.enabled = params.use_docker
        process.container = params.use_docker ? params.container_image : null
        process {
            withName: 'run_model|run_model_openrouter' {
                queue = 'gpu-single'
                time = '4h'
                clusterOptions = '--gres=gpu:1'
                executor = 'slurm'
                memory = '64 GB'
            }
            queue = 'cpu-single'
            time = '1h'
            executor = 'slurm'
            memory = '128 GB'
            cpus = 1

        }
    }
    imbi_gpu {
    conda.enabled = true

    process {
      executor = 'local'
      time     = '1h'
      memory   = '60 GB'
      cpus     = 1

      withName: 'run_model|run_model_openrouter' {
        executor       = 'slurm'
        time           = '48h'
        memory         = '60 GB'
        clusterOptions = '--gres=gpu:1'
      }

    }
  }

    docker {
        docker.enabled = true
        conda.enabled = false
        process.container = params.container_image
        process.executor = 'local'
        process.cpus = 12
        process.memory = '48 GB'

        process {
            withName: 'run_model|run_model_openrouter' {
                containerOptions = '--gpus 1'
            }
        }
    }

    // Laptop-sized Docker profile: no GPU, matches the `local` profile's resources.
    // Apple Silicon users rely on Docker Desktop's amd64 emulation (slower).
    docker_local {
        docker.enabled = true
        conda.enabled = false
        process.container = params.container_image
        process.executor = 'local'
        process.cpus = 4
        process.memory = '80 GB'
    }

    apptainer {
        apptainer.enabled = true
        conda.enabled = false
        process.container = "docker://${params.container_image}"
        process.executor = 'local'
        process.cpus = 12
        process.memory = '48 GB'

        process {
            withName: 'run_model|run_model_openrouter' {
                containerOptions = '--nv'
            }
        }
    }
}

workDir = "work"
params.datasets = ['Zeisel', 'HFRA', 'human_pancreas', 'HIHA']
// SingleR is a SINGLE model `singler_blind`. For celldex-referenced datasets it uses the best tier
// (label.ont, set via `singler_reference_tier` in the dataset YAML); for datasets declaring a
// CELLxGENE reference (`singler_reference_source: cellxgene` + `singler_reference_id`) it fetches
// that atlas and annotates against its `cell_type` column. The old per-tier models
// (singler_main/fine/ont_blind) still exist for manual runs but are deselected here (their cached
// predictions/results are kept for the record). `ucell_blind` is intentionally absent: UCell
// prescribes no rule for assigning a label from its scores (its authors' own scGate refuses argmax
// and returns "Multi"/NA), so the argmax used here is not an endorsed usage.
// params.models = ['cell_baseline', 'openrouter_LLM_blind', 'openrouter_LLM_unblind', 'celltypist_blind', 'celltypist_unblind', 'c2s_blind', 'c2s_scale_2B_blind', 'c2s_scale_2B_unblind', 'c2s_scale_27B_blind', 'c2s_scale_27B_unblind', 'cellwhisperer_blind', 'cellwhisperer_unblind', 'instructcell_blind', 'instructcell_unblind', 'langcell_blind', 'langcell_unblind', 'mmcontext_blind', 'mmcontext_unblind', 'random_stratified', 'random_uniform', 'scsa_blind', 'scsa_unblind', 'sctype_blind', 'sctype_unblind', 'singler_blind', 'singler_unblind', 'singler_main_blind', 'singler_fine_blind', 'singler_ont_blind']
params.models = ['scsa_blind', 'celltypist_blind', 'sctype_blind', 'singler_blind',
                 'scsa_unblind', 'celltypist_unblind', 'sctype_unblind', 'singler_unblind']
params.cache_dir = 'cache'
params.apply_ontology_mapping = true  // fallback for datasets without per-dataset flag
params.use_text_encoder = false  // also compute mapping-free text-encoder (SapBERT) cosine similarity.
                                 // DISABLED for local Apple-Silicon runs: the text encoder needs
                                 // torch, whose x86 wheel segfaults doing SapBERT inference under
                                 // Rosetta (exit 139), and the crash aborts scoring before any
                                 // metrics are written. The core metrics (balanced accuracy,
                                 // macro-F1, ontology similarity) are torch-free. Re-enable (true)
                                 // on Linux / the cluster, where torch runs natively.
params.text_encoder_model = 'cambridgeltl/SapBERT-from-PubMedBERT-fulltext'  // HF encoder for the text-similarity metric (use 'sentence-transformers/all-MiniLM-L6-v2' for a zero-download fallback)
params.min_scoring_coverage = 0.9  // min fraction of cells with a trusted mapping (direct CL term OR reviewed=True) needed to emit metrics; below this a model's metrics are NaN
params.download_from_zenodo = true  // if true, fetch preprocessed+subsetted files from Zenodo instead of running download→preprocess→subset
params.min_cells_per_type = 20       // minimum cells per cell type in subset (types below are dropped)
params.subset_categories = [
    'openrouter': 1000,            // LLMs get the smaller subset
    'langcell_blind': 1000,        // Very slow
    'default': [1000, 10000]       // all other models run at BOTH sizes (a value may be a single
                                   // size or a list of sizes; the model is run once per size)
]
// Constrained baselines (<baseline>_unblind): given the eval subset's true cell types, a baseline
// answers only with its labels that count for one of them (bin/util/label_constraint.py), as the
// constrained language models choose from that list. The constraint is rebuilt from the current
// mapping table on every run, but cached predictions are reused as they are: after editing the
// mappings, delete cache/models/predictions/<b>_unblind to re-run a constrained baseline.
params.label_constraint_models = ['singler_unblind', 'celltypist_unblind', 'sctype_unblind', 'scsa_unblind']
// The SingleR models that read a fetched CELLxGENE reference on datasets that declare one.
params.singler_reference_models = ['singler_blind', 'singler_unblind']
params.subset_strategy = 'stratified'  // 'stratified' (preserve proportions) or 'random' (uniform, preserve natural imbalance)

// Clustering context for the cluster-level annotators (sctype_blind, scsa_blind). When either is
// selected, the pipeline additionally fetches + preprocesses the FULL dataset (even on the Zenodo
// fast-path) and builds a <dataset>_context.h5ad that CONTAINS both eval subsets, so these methods
// cluster on up to `context_max_size` cells (rare types can form their own cluster) and then score
// + emit only the fixed eval cells. `context_min_cells_per_type` is the per-type floor the fill
// aims for; below ~2*sqrt(n/k) a type cannot form its own Louvain cluster (resolution limit).
params.cluster_context_models = ['sctype_blind', 'scsa_blind', 'sctype_unblind', 'scsa_unblind']  // models that consume the context
params.context_max_size = 100000              // cap on context size; the whole dataset if smaller
params.context_min_cells_per_type = 150       // per-type floor for the context fill (clustering resolution limit)
// Where the clustering context comes from (independent of download_from_zenodo, which governs the
// eval subsets). true: fetch prebuilt <dataset>_context.h5ad from Zenodo (fast, the default for
// users). false: build it locally from the full preprocessed data (heavy: full download+preprocess)
// -- this is how the contexts are produced in the first place, to then upload to Zenodo.
params.fetch_context_from_zenodo = true

// SingleR custom (CELLxGENE) reference: max cells per label kept when normalizing a fetched reference
// atlas (bin/prepare_singler_reference.py). Caps 120k-400k-cell atlases to keep SingleR fast/low-
// memory while preserving every cell type; deterministic (seeded). 0/negative = no cap (use full ref).
params.singler_reference_cap_per_label = 500

// Apple Silicon + conda + R models: bioconductor-singler / scran have NO osx-arm64 conda build, so
// building their envs natively aborts the run (PackagesNotFoundError); the packages DO exist for
// osx-64 (run under Rosetta 2). There is no config-only fix: Nextflow builds yaml envs with
// `conda env create --file`, which — unlike `conda create` — ignores `conda.createOptions`, so a
// `--platform`/subdir cannot be injected from here. The reliable lever is the CONDA_SUBDIR env var,
// which conda honours for every operation. CONDA_ALWAYS_COPY=true is also required: without it the
// concurrent R-env builds race on conda's package hardlinks and abort with a LinkError; copying
// (instead of hardlinking) packages into each env prefix avoids the race. So on Apple Silicon,
// launch the R methods with BOTH set:
//     CONDA_SUBDIR=osx-64 CONDA_ALWAYS_COPY=true nextflow run main.nf -profile local
// (Linux / Intel macOS need neither; the container profiles use params.r_container_image instead.)

// OpenRouter API key is provided via Nextflow secrets (see README): nextflow secrets set OPENROUTER_API_KEY 'sk-or-v1-...'
// Only the run_model_openrouter process declares `secret 'OPENROUTER_API_KEY'`, which injects the value into the
// task env at runtime without writing it into the work directory's .command.sh / .command.run files. Non-OpenRouter
// models run via run_model, which does not declare the secret, so they don't require the key to be set.

// Models that should be skipped for specific organisms (keys are normalized to lowercase).
// Example: 'mus musculus' => ['some_model_blind', 'some_model_unblind']
params.model_blacklist_by_organism = [:]

// Models that read human genes only (human Ensembl IDs or symbols). On a dataset whose organism has
// a table here, they get the subset with its genes mapped to one-to-one human orthologs
// (bin/orthologize.py); the table holds one-to-one mouse-human orthologs from Ensembl 114.
params.human_gene_models = ['cellwhisperer_blind', 'cellwhisperer_unblind', 'instructcell_blind', 'instructcell_unblind',
                            'langcell_blind', 'langcell_unblind', 'mmcontext_blind', 'mmcontext_unblind']
params.ortholog_tables = ['mus musculus': 'cache/ENSEMBL/mouse_human_one2one_orthologs_ensembl114.tsv']
