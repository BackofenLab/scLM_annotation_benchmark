// Parameters of the pipeline. Every value can be changed on the command line (--name value)
// or in a file passed with -params-file.
//
// Dataset parameters, including quality control and preprocessing, are in datasets/<name>.yml.
// Method parameters are in models/<method>/method.yml. See docs/parameters.md.

params {
    // What to run: names of files in datasets/ and of folders in models/.
    datasets = ['HFRA', 'HIHA', 'Zeisel', 'human_pancreas']
    models   = ['celltypist_unconstrained', 'scsa_unconstrained', 'sctype_unconstrained', 'singler_unconstrained',
                'celltypist_constrained', 'scsa_constrained', 'sctype_constrained', 'singler_constrained']

    // Test sets.
    subset_sizes       = [1000, 10000]   // cells per test set; a method can set an upper limit
    subset_strategy    = 'stratified'    // 'stratified' keeps the proportions of the cell types, 'random' samples cells
    min_cells_per_type = 20              // a stratified test set holds at least this many cells per type
    download_from_zenodo = true          // fetch the test sets from Zenodo instead of building them
    annotation_subset_size = null        // annotate.nf: cells to annotate per dataset; null annotates all cells

    // Clustering sample for the methods that annotate clusters.
    fetch_context_from_zenodo  = true    // fetch the sample from Zenodo instead of building it
    context_max_size           = 100000  // cells in the sample; the whole dataset if it is smaller
    context_min_cells_per_type = 150     // cells per type the sample aims for

    // Clustering for the methods that annotate clusters (bin/cluster_cells.py), as in the usual
    // scanpy workflow. The per-cluster analysis of the paper used cluster_n_top_genes = 0,
    // cluster_scale = false and cluster_use_batch_key = false. A dataset with cluster_key in its
    // yml brings its own clusters, and only their marker genes are ranked.
    cluster_resolution    = 1.0          // Leiden resolution; higher values give more clusters
    cluster_n_pcs         = 50
    cluster_n_neighbors   = 15
    cluster_n_top_genes   = 2000         // highly variable genes for the PCA; 0 uses all genes
    cluster_scale         = true         // scale the genes before the PCA
    cluster_use_batch_key = true         // select the highly variable genes within each batch
    cluster_integration   = 'none'       // 'harmony' corrects the PCA for the dataset's batch_key
    cluster_marker_genes  = 25           // marker genes per cluster
    cluster_rank_method   = 'wilcoxon'
    cluster_seed          = 0

    // Inputs of single methods.
    candidate_types = "${projectDir}/resources/all_cell_types.txt"   // names offered to the unconstrained embedding methods
    singler_reference_cap_per_label = 500    // cells per label kept of a CELLxGENE reference; 0 keeps all
    ortholog_tables = ['mus musculus': 'resources/ensembl/mouse_human_one2one_orthologs_ensembl114.tsv']

    // Mapping of answers to the Cell Ontology.
    mappings           = "${projectDir}/resources/cell_type_ontology_mappings.csv"
    append_new_answers = true            // main.nf adds answers that are new to the table for review

    // Evaluation.
    min_scoring_coverage = 0.9           // share of reviewed answers below which a run gets no metrics
    use_text_encoder     = false         // also score the similarity of label texts (needs torch)
    text_encoder_model   = 'cambridgeltl/SapBERT-from-PubMedBERT-fulltext'

    // Folders.
    cache_dir       = 'cache'            // downloads, test sets and intermediate files
    outdir          = 'results'          // annotations, scores, tables and plots
    predictions_dir = null               // stored predictions; default <outdir>/predictions

    // Container images, used by the container profiles. Methods written in R use the second.
    container_image   = 'pavanvidem/sc_lfm:2026-04-17'
    r_container_image = 'pavanvidem/sc_lfm_r:2026-04-17'
    use_docker        = false            // profile helix: containers instead of conda
}

process {
    beforeScript = '''
        if [[ -n "${CONDA_PREFIX:-}" ]]; then
            export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
        fi
        export KMP_DUPLICATE_LIB_OK=TRUE
    '''
}

// A method run that fails in every attempt is left out (modules/methods.nf); the run then
// finishes the other tasks and ends with an error.
workflow.failOnIgnore = true

// The first build of an environment can take longer than Nextflow's default of 20 minutes.
conda.createTimeout = '2 h'

docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp -e MPLCONFIGDIR=/tmp'
docker.temp = 'auto'
apptainer.runOptions = '-e HOME=/tmp -e MPLCONFIGDIR=/tmp'
workDir = 'work'

profiles {

    // This machine, with one conda environment per step.
    local {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '32 GB'
        conda.enabled    = true
        docker.enabled   = false
    }

    // This machine, with Docker and one GPU.
    docker {
        docker.enabled    = true
        conda.enabled     = false
        process.container = params.container_image
        process.executor  = 'local'
        process.cpus      = 12
        process.memory    = '48 GB'
        process {
            withName: 'run_method|run_method_with_key' {
                containerOptions = '--gpus 1'
            }
        }
    }

    // This machine, with Docker and without GPU.
    docker_local {
        docker.enabled    = true
        conda.enabled     = false
        process.container = params.container_image
        process.executor  = 'local'
        process.cpus      = 4
        process.memory    = '80 GB'
    }

    // This machine, with Apptainer and one GPU.
    apptainer {
        apptainer.enabled = true
        conda.enabled     = false
        process.container = "docker://${params.container_image}"
        process.executor  = 'local'
        process.cpus      = 12
        process.memory    = '48 GB'
        process {
            withName: 'run_method|run_method_with_key' {
                containerOptions = '--nv'
            }
        }
    }

    // SLURM cluster with a GPU queue for the methods (bwForCluster Helix).
    helix {
        conda.enabled     = !params.use_docker
        docker.enabled    = params.use_docker
        process.container = params.use_docker ? params.container_image : null
        process {
            executor = 'slurm'
            queue    = 'cpu-single'
            time     = '1h'
            memory   = '128 GB'
            cpus     = 1
            withName: 'run_method|run_method_with_key' {
                queue          = 'gpu-single'
                time           = '4h'
                memory         = '64 GB'
                clusterOptions = '--gres=gpu:1'
            }
        }
    }

    // Local steps, with the methods submitted to SLURM on a GPU node.
    slurm_gpu {
        conda.enabled = true
        process {
            executor = 'local'
            time     = '1h'
            memory   = '60 GB'
            cpus     = 1
            withName: 'run_method|run_method_with_key' {
                executor       = 'slurm'
                time           = '48h'
                memory         = '60 GB'
                clusterOptions = '--gres=gpu:1'
            }
        }
    }
}
