process {
    // Prefer libraries from the active conda env (e.g. libstdc++) over system libs.
    beforeScript = '''
        if [[ -n "${CONDA_PREFIX:-}" ]]; then
            export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
        fi
    '''
}

profiles {
    
    local {
        process.executor   = 'local'   // run on this machine
        process.cpus       = 4
        process.memory     = '8 GB'
        conda.enabled      = true      // honour conda directives

        process {
            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }

    helix {
        conda.enabled = true
        process {
            withName: run_model {
                queue = 'gpu-single'
                time = '4h'
                clusterOptions = '--gres=gpu:1'
                executor = 'slurm'
                memory = '64 GB'
            }
            queue = 'cpu-single'
            time = '1h'
            executor = 'slurm'
            memory = '64 GB'
            cpus = 1

            withName: run_model_throttled {
                maxForks = 1
            }
        }
    }
}

