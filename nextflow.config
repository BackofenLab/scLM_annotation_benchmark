profiles {
    
    local {
        process.executor   = 'local'   // run on this machine
        process.cpus       = 4
        process.memory     = '8 GB'
        conda.enabled      = true      // honour conda directives
    }

    helix {
        conda.enabled = true
        process {
            withName: embed {
                queue = 'gpu-single'
                time = '4h'
                clusterOptions = '--gres=gpu:1'
                executor = 'slurm'
                memory = '64 GB'
            }
            queue = 'cpu-single'
            time = '1h'
            executor = 'slurm'
            memory = '64 GB'
            cpus = 1
        }
    }
}

