# Nextflow
work/
.nextflow*
nextflow

# Downloads, test sets and intermediate files of the pipeline
cache/

# Outputs of pipeline runs
/results/
/results_*/
/Results

# Python, R and system files
__pycache__/
*.py[cod]
.Rhistory
.DS_Store
.env
*.swp

# Code and weights that the methods fetch in their prepare.sh
models/*/src/CellWhisperer/
models/*/src/InstructCell/
models/*/src/LangCell/
models/*/src/SCSA/
models/*/src/data/
models/*/src/downloads/
